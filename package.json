{
  "name": "ejemplo-playwright-curso-avanzado",
  "version": "1.0.0",
  "private": true,
  "description": "Segundo laboratorio del curso de Playwright: selectores, fixtures, datos, evidencias y CI.",
  "scripts": {
    "start": "node server.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug=inspector",
    "test:ui": "playwright test --ui",
    "test:retry-demo": "playwright test --config=playwright.retry.config.ts",
    "cdp:browser": "node scripts/iniciar-cdp.mjs",
    "cdp:browser:headless": "node scripts/iniciar-cdp.mjs --headless",
    "cdp:connect": "node scripts/conectar-cdp.mjs",
    "test:report": "playwright show-report playwright-report",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:ci": "npm run typecheck && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}

